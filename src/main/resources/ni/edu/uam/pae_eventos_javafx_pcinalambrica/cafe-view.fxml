<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      prefHeight="600.0"
      prefWidth="700.0"
      spacing="15.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.pae_eventos_javafx_pcinalambrica.controllers.CafeController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="RECEPCIÓN DE CAFÉ">
        <font>
            <Font size="22.0"/>
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10.0">

        <Label text="Código:"/>

        <TextField fx:id="txtCodigo"
                   prefWidth="120.0"/>

        <Label text="Productor:"/>

        <TextField fx:id="txtProductor"
                   prefWidth="150.0"/>

    </HBox>

    <HBox alignment="CENTER" spacing="10.0">

        <Label text="Tipo de café:"/>

        <TextField fx:id="txtTipoCafe"
                   prefWidth="150.0"/>

        <Label text="Peso:"/>

        <TextField fx:id="txtPeso"
                   prefWidth="120.0"/>

    </HBox>

    <Button fx:id="btnAgregar"
            onAction="#OnClickAgregar"
            text="Agregar lote"/>

    <Label fx:id="lblDetalles"
           text="Seleccione un lote para ver sus detalles"/>

    <TableView fx:id="tablaLotes"
               prefHeight="350.0"
               prefWidth="650.0"
               onMouseClicked="#OnMouseClicked">

        <columns>

            <TableColumn fx:id="colCodigo"
                         prefWidth="120.0"
                         text="Código"/>

            <TableColumn fx:id="colProductor"
                         prefWidth="180.0"
                         text="Productor"/>

            <TableColumn fx:id="colTipoCafe"
                         prefWidth="150.0"
                         text="Tipo de café"/>

            <TableColumn fx:id="colPeso"
                         prefWidth="120.0"
                         text="Peso (kg)"/>

        </columns>

    </TableView>

</VBox>